---
// Who uses agent-device: one row per adopter, each with what they do with it and the public
// source that shows it (content.ts `adopters`). Names only, no logos.
import Site from '../layouts/Site.astro';
import Closing from '../components/site/Closing.astro';
import Footer from '../components/site/Footer.astro';
import Nav from '../components/site/Nav.astro';
import { adopters, site } from '../site/content';

const md = (s: string) => s.replaceAll(/`([^`]+)`/g, '<code>$1</code>');
const addYourself = `${site.repo}/edit/main/website/src/site/content.ts`;
---

<Site
  title="Showcase"
  description="Teams and projects that use agent-device, each with a link to the public code or post that shows how."
>
  <Nav />
  <main class="frame">
    <section class="page-head" aria-labelledby="showcase-title">
      <p class="section-head label"><b>[{String(adopters.length).padStart(2, '0')}]</b> Showcase</p>
      <div class="intro">
        <h1 class="h2" id="showcase-title">Used in their repos. <em>Open the source and see.</em></h1>
        <p class="lede">
          These teams and projects run agent-device in public code or have written about it. Every
          entry links to where you can see it at work.
        </p>
      </div>
    </section>

    <ol class="adopters">
      {
        adopters.map((a) => (
          <li class="adopter">
            <div class="who">
              <h2 class="h3">{a.name}</h2>
              {a.project && <span class="label project">{a.project}</span>}
            </div>
            <p class="body how" set:html={md(a.how)} />
            <ul class="sources">
              {a.sources.map((s) => (
                <li>
                  <a class="label more" href={s.href}>
                    {s.text} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <section class="add" aria-labelledby="add-title">
      <h2 class="h3" id="add-title">Using agent-device?</h2>
      <p class="body">
        Add your team with a pull request to the list, with a link to public code or a post that
        shows how you use it.
      </p>
      <a class="label more" href={addYourself}>Add your team <span aria-hidden="true">↗</span></a>
    </section>

    <Closing />
  </main>
  <Footer />
</Site>

<style>
  .adopters {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .adopter {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr) 18rem;
    gap: 1rem 2rem;
    align-items: start;
    padding: 1.5rem var(--pad);
    border-bottom: 1px solid var(--line);
  }
  .who {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .who .h3 {
    margin: 0;
  }
  .project {
    color: var(--accent);
  }
  .how {
    margin: 0;
  }
  .sources {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .add {
    display: grid;
    gap: 0.75rem;
    padding: 2rem var(--pad);
    border-bottom: 1px solid var(--line);
  }
  .add .h3,
  .add .body {
    margin: 0;
  }
  @media (max-width: 64rem) {
    .adopter {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
