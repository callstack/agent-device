---
// The same lockup as the landing pages: the mark (if any), the wordmark block, "by Callstack".
// The block is the bright accent in both themes, from the --accent variable (brand.ts).
import { site } from '../../site/content';
import Mark from '../site/Mark.astro';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label={`${site.name} by Callstack, home`}>
  <Mark height={20} class="mark" />
  <span class="wordmark" translate="no">{site.wordmark}</span>
  <span class="by">by Callstack</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-title :global(.mark) {
    color: var(--accent);
    margin-inline-end: 0.125rem;
  }
  .wordmark {
    padding: 0.0625rem 0.3125rem;
    background: var(--accent);
    color: #0a0a0a;
    font-family: var(--cs-font-display);
    font-weight: 500;
    font-size: 1.125rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .by {
    padding: 0.25rem 0.375rem;
    background: var(--sl-color-gray-6);
    font-family: var(--cs-font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .site-title:hover .wordmark {
    background: var(--accent-hover);
  }
  @media (max-width: 30rem) {
    .by {
      display: none;
    }
  }
</style>
