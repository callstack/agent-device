---
// Docs pages keep Starlight's footer (edit link, pagination) and end with the brand strip: the
// same copyright and links as the landing pages' footer, from content.ts.
import Default from '@astrojs/starlight/components/Footer.astro';

import { footer, site } from '../../site/content';

const year = new Date().getFullYear();
---

<Default />
<div class="cs-footer">
  <span>© {year} {site.name} by {site.owner}</span>
  <nav class="links" aria-label="Footer">
    {footer.map(({ text, href }) => <a href={href}>{text}</a>)}
  </nav>
</div>

<style>
  .cs-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    justify-content: space-between;
    align-items: center;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--cs-line);
    font-family: var(--cs-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    color: var(--cs-muted);
  }
  .cs-footer a {
    color: inherit;
    text-decoration: none;
  }
  .cs-footer a:hover {
    color: var(--sl-color-white);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
</style>
