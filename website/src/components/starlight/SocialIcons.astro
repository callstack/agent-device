---
// Header links: mono, uppercase, text only. The nav links from content.ts that leave the docs,
// then the GitHub stars.
import GitHubStars from '../site/GitHubStars.astro';
import { nav } from '../../site/content';

const links = nav
  .filter(({ href }) => !href.startsWith('/docs'))
  .map(({ text, href }) => ({ label: text, href, external: /^https?:/.test(href) }));
---

{
  links.map(({ label, href, external }) => (
    <a href={href} class="cs-header-link">
      {label}
      {external && <span aria-hidden="true">↗</span>}
    </a>
  ))
}
<GitHubStars class="cs-header-link" />

<style>
  :global(.cs-header-link) {
    font-family: var(--cs-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    color: var(--cs-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  :global(.cs-header-link:hover) {
    color: var(--sl-color-white);
  }
  .cs-header-link span {
    margin-inline-start: 0.25em;
  }
</style>
