---
// A one-line shell command with a copy button.
interface Props {
  command: string;
  class?: string;
}
const { command, class: className } = Astro.props;
---

<div class:list={['cmd', className]}>
  <code class="cmd-text"><span class="cmd-prompt" aria-hidden="true">$</span>{command}</code>
  <button class="cmd-copy label" type="button" data-copy={command} aria-label={`Copy ${command}`}>Copy</button>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Press ⌘C';
      }
      setTimeout(() => (button.textContent = 'Copy'), 1600);
    });
  }
</script>

<style>
  .cmd {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    width: min(100%, 36rem);
    padding: 0.625rem 0.625rem 0.625rem 1rem;
    background: var(--bg);
    border: 1px solid var(--line-strong);
  }
  .cmd-text {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text);
    scrollbar-width: none;
  }
  .cmd-prompt {
    margin-inline-end: 0.75rem;
    color: var(--accent);
  }
  .cmd-copy {
    padding: 0.375rem 0.625rem;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .cmd-copy:hover {
    color: var(--accent);
  }
  @media (max-width: 30rem) {
    .cmd {
      gap: 0.5rem;
      padding-left: 0.75rem;
    }
    .cmd-prompt {
      margin-inline-end: 0.5rem;
    }
  }
</style>
