# Smoke test for Linux desktop automation on CI.
# Opens gnome-calculator, takes a snapshot, and validates the
# accessibility tree contains expected calculator UI elements.
context platform=linux
open gnome-calculator
wait "appname=gnome-calculator || windowtitle=Calculator || label=Calculator || label=0 || label=1 || label=5" 15000
screenshot "./test/screenshots/replays/linux-calculator.png"
snapshot
# Verify calculator-specific elements: a window titled Calculator,
# or digit buttons that only a calculator app would expose.
is exists "appname=gnome-calculator || windowtitle=Calculator || label=Calculator || label=0 || label=1 || label=5"
snapshot -i
# R40 (#1739): `focus` executes through the bound `focusPoint` operation rather than the retired
# interactor leaf. A coordinate focus, deliberately at a desktop point: it proves the migrated
# path drives a real click without depending on window placement.
focus 100 100
# The session survives the focus: a crashed desktop would fail here, not silently pass above.
is exists "appname=gnome-calculator || windowtitle=Calculator || label=Calculator || label=0 || label=1 || label=5"
# R41 (#1739): `type` executes through the bound `typeText` operation rather than the retired
# interactor leaf. Digits only: run 32485981780's artifact proved digits land in the entry, and
# run 32487868346's proved the `=` keystroke does not arrive on this lane, so the assertion
# reads the entry's own accessible text instead of a computed result.
type "155"
# Uploaded on pass and on fail: the display pixels are the ground truth for the step above, so
# a wait timeout below is diagnosable from the artifact alone.
screenshot "./test/screenshots/replays/linux-calculator-typed.png"
# The AT-SPI dumper reads the entry's Text interface into the node's `value`, and value= matches
# it. No button is labelled 155, so this passes only if the typed keystrokes reached the entry;
# deleting the type step turns it red.
wait "value=155 || label=155 || text=155" 10000
