# Text input.
context platform=android

open settings --relaunch
snapshot -i

click 'text="Search Settings"'
wait 'role=text-field focused=true' 5000
is focused 'role=text-field'
screenshot "./test/screenshots/replays/android-search-focused.png"
snapshot -i

keyboard status

type "Display"
wait 'role=text-field value="Display"' 5000
is focused 'role=text-field value="Display"'
screenshot "./test/screenshots/replays/android-search-typed.png"
snapshot -i

screenshot "./test/screenshots/replays/android-search-results.png"

keyboard status

back
wait 1000
keyboard status
snapshot -i
find text "Search" exists
