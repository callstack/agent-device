+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+/**
+ * Wrapper length of a transformed module.
+ *
+ * The module evaluator runs a transformed module as `<wrapper><module source>`,
+ * and V8 reports block offsets against the whole script, so turning a module's
+ * coverage back into source coordinates needs the length of that wrapper. The
+ * evaluator records it per module only after the module body has been awaited, so
+ * a dynamic import still in flight when the worker takes its coverage has no entry
+ * and therefore no known length. `0` is itself a real length (an untransformed
+ * script has no wrapper), so it cannot double as "unknown": the worker reports
+ * this sentinel instead, and the merge below resolves the module from the workers
+ * that did measure a wrapper.
+ */
+const UNKNOWN_WRAPPER_LENGTH = -1;
+
+/**
+ * Collects the wrapper length of every script URL in one project/environment group
+ * while its coverage files are read, so the length stays a fact about the module
+ * instead of a fact about the last coverage file that happened to be read.
+ */
+class WrapperLengths {
+	/** url -> the single length its workers measured, `null` once two differed */
+	lengths = /* @__PURE__ */ new Map();
+	/** urls a worker explicitly reported as unmeasured */
+	unmeasured = /* @__PURE__ */ new Set();
+	add(url, startOffset) {
+		if (startOffset === void 0) {
+			// A provider that does not report wrapper lengths at all (browser mode runs
+			// modules unwrapped in the page, so its scripts have no entry to carry).
+			return;
+		}
+		if (startOffset === UNKNOWN_WRAPPER_LENGTH) {
+			this.unmeasured.add(url);
+			return;
+		}
+		const known = this.lengths.get(url);
+		if (known === void 0) this.lengths.set(url, startOffset);
+		else if (known !== startOffset) this.lengths.set(url, null);
+	}
+	/**
+	 * The length to convert `url` with, or `UNKNOWN_WRAPPER_LENGTH` when the module's
+	 * offsets cannot be placed in its own source: no worker measured the wrapper, or
+	 * workers measured different ones. Guessing `0` there would shift every offset by
+	 * the wrapper and report plausible-looking counts for the wrong statements.
+	 */
+	resolve(url) {
+		const known = this.lengths.get(url);
+		if (known !== void 0) return known === null ? UNKNOWN_WRAPPER_LENGTH : known;
+		return this.unmeasured.has(url) ? UNKNOWN_WRAPPER_LENGTH : 0;
+	}
+	clear() {
+		this.lengths.clear();
+		this.unmeasured.clear();
+	}
+}
+
+/**
+ * The paths `ast-v8-to-istanbul` keys its output under for `url`: the mapped
+ * sources when the transform carried a source map (the provider resolves them to
+ * absolute `file://` hrefs before converting), the script itself otherwise.
+ */
+function reportPaths(url, sourceMap) {
+	const sources = sourceMap?.sources;
+	if (!sources?.length) return [fileURLToPath(url)];
+	const directory = dirname(fileURLToPath(url));
+	return sources.map((source) =>
+		source.startsWith('file://') ? fileURLToPath(source) : resolve(directory, source),
+	);
+}
+
+/**
+ * Istanbul records for a module whose coverage could not be placed in its source.
+ *
+ * A record with no counters would merge as 0% coverage and score as though the
+ * file were untested, so each record carries one impossible hit count instead:
+ * `null` survives merging with a measured record for the same file (istanbul adds
+ * counts only when both sides are numbers), so the file cannot be repaired into
+ * looking valid, and consumers that validate counts drop the record and report the
+ * file as unscored rather than scoring it from shifted offsets. The statement sits
+ * past any real line so the marker never lands on a line the file really has.
+ */
+function unmappableCoverageRecord(url, sourceMap) {
+	const line = Number.MAX_SAFE_INTEGER;
+	const location = { line, column: 0 };
+	const record = (path) => ({
+		path,
+		statementMap: { 0: { start: location, end: { line, column: location.column + 1 } } },
+		fnMap: {},
+		branchMap: {},
+		s: { 0: null },
+		f: {},
+		b: {},
+	});
+	return Object.fromEntries(reportPaths(url, sourceMap).map((path) => [path, record(path)]));
+}
+
+export { UNKNOWN_WRAPPER_LENGTH, WrapperLengths, unmappableCoverageRecord };
