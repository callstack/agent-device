{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "extends": ["./.fallowrc.json"],
  // Coverage-based CRAP only: scripts/coverage-crap/run.ts passes the threshold (--max-crap), the
  // Vitest coverage map and the PR diff. Cyclomatic and cognitive findings stay with check:fallow.
  "rules": {
    "complexity-cyclomatic": "off",
    "complexity-cognitive": "off"
  },
  "health": {
    "thresholdOverrides": [
      {
        "files": ["packages/platform-web/src/agent-browser-audio-probe.ts"],
        "maxCrap": 1e12,
        "reason": "These functions are serialized into one string and evaluated inside the browser page, so the Node coverage map can never record them. buildAudioProbeEvalScript is what ships them, and the normalize side is unit-tested."
      },
      {
        // `pnpm exec vitest run packages/capture-kit/src/png-worker-client.test.ts` proves every
        // job kind answers on the worker thread (a pending job holds a MessagePort resource the
        // synchronous fallback has none of), but that thread's execution is not in the coverage map.
        "files": ["packages/capture-kit/src/png-worker.ts"],
        "maxCrap": 1e12,
        "reason": "This file is a node:worker_threads entry; the Vitest coverage map only records the instrumented main thread, so its job switch always measures 0%."
      }
    ]
  }
}
