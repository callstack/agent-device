{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./dist-types",
    "tsBuildInfoFile": "./dist-types/index.tsbuildinfo",
    "rootDir": ".",
    "paths": {
      "agent-device/plugins": ["./node_modules/agent-device/src/sdk/plugins.ts"],
      "agent-device/plugins/device-host": [
        "./node_modules/agent-device/src/sdk/plugin-device-host.ts"
      ]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../build-config" },
    { "path": "../capture-kit" },
    { "path": "../contracts" },
    { "path": "../host-kit" },
    { "path": "../kernel" },
    { "path": "../platform-android" },
    { "path": "../platform-apple" },
    { "path": "../test-kit" },
    { "path": "../xml" }
  ]
}
