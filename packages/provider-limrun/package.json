{
  "name": "@agent-device/provider-limrun",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "agent-device": {
    "apiVersion": 3,
    "provider": "limrun"
  },
  "private": true,
  "type": "module",
  "description": "Limrun provider runtime for agent-device. Internal workspace package bundled into the published artifact.",
  "dependencies": {
    "@agent-device/capture-kit": "workspace:*",
    "@agent-device/contracts": "workspace:*",
    "@agent-device/kernel": "workspace:*",
    "@agent-device/platform-android": "workspace:*",
    "@agent-device/plugins": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./internal": {
      "types": "./src/internal.ts",
      "default": "./src/internal.ts"
    }
  },
  "devDependencies": {
    "@agent-device/platform-apple": "workspace:*",
    "@agent-device/test-kit": "workspace:*",
    "@limrun/api": "^0.69.1"
  }
}
