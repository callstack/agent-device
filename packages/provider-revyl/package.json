{
  "name": "@agent-device/revyl",
  "version": "0.22.0-dev",
  "type": "module",
  "description": "Revyl cloud iOS simulator and Android emulator plugin for agent-device.",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "prepack": "pnpm build"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./agent-device": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@agent-device/capture-kit": "workspace:*",
    "@agent-device/contracts": "workspace:*",
    "@agent-device/kernel": "workspace:*",
    "@agent-device/provision-kit": "workspace:*",
    "@agent-device/provider-webdriver": "workspace:*",
    "@agent-device/test-kit": "workspace:*",
    "agent-device": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/agent-device.mjs"
      },
      "./agent-device": {
        "import": "./dist/agent-device.mjs"
      }
    },
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callstack/agent-device.git",
    "directory": "packages/provider-revyl"
  },
  "homepage": "https://agent-device.dev/docs/revyl"
}
