{
  "name": "@agent-device/replay-port",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "description": "Daemon-side replay port: the adapter over the ad-replay, ad-script and replay-test engines.",
  "dependencies": {
    "@agent-device/ad-script": "workspace:*",
    "@agent-device/contracts": "workspace:*",
    "@agent-device/kernel": "workspace:*",
    "@agent-device/selectors": "workspace:*"
  },
  "exports": {
    "./target-token": {
      "types": "./src/daemon-port/target-token.ts",
      "default": "./src/daemon-port/target-token.ts"
    },
    "./repair-hint": {
      "types": "./src/daemon-port/repair-hint.ts",
      "default": "./src/daemon-port/repair-hint.ts"
    },
    "./script-source": {
      "types": "./src/daemon-port/script-source.ts",
      "default": "./src/daemon-port/script-source.ts"
    },
    "./session-replay-vars": {
      "types": "./src/session-replay-vars.ts",
      "default": "./src/session-replay-vars.ts"
    }
  }
}
