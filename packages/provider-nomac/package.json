{
  "name": "@agent-device/nomac",
  "version": "0.21.36-dev",
  "type": "module",
  "description": "NoMac Simulator iPhone and iPad Simulators as an agent-device provider plugin.",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "prepack": "pnpm build"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./agent-device": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@agent-device/capture-kit": "workspace:*",
    "@agent-device/contracts": "workspace:*",
    "@agent-device/kernel": "workspace:*",
    "@agent-device/plugins": "workspace:*",
    "agent-device": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/agent-device.mjs"
      },
      "./agent-device": {
        "import": "./dist/agent-device.mjs"
      }
    },
    "access": "public"
  },
  "license": "MIT"
}
