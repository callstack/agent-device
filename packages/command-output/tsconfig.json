{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./dist-types",
    "rootDir": "./src",
    "tsBuildInfoFile": "./dist-types/index.tsbuildinfo"
  },
  // The command-registry sources this package imports read the `__OWNER_FILES__` build-time flag
  // declared beside them; a package program that reaches registry.ts needs the declaration too.
  "include": ["src", "../command-registry/src/global.d.ts"],
  "references": [
    { "path": "../ad-replay" },
    { "path": "../capture-kit" },
    { "path": "../command-registry" },
    { "path": "../command-surface" },
    { "path": "../contracts" },
    { "path": "../host-kit" },
    { "path": "../kernel" },
    { "path": "../test-kit" }
  ]
}
