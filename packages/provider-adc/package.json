{
  "name": "@agent-device/adc",
  "version": "0.22.0-dev",
  "private": true,
  "type": "module",
  "description": "ADC Android phones and TVs for agent-device.",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "prepack": "pnpm build"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./agent-device": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "agent-device": "workspace:*",
    "ws": "^8.21.3",
    "@agent-device/contracts": "workspace:*",
    "@agent-device/kernel": "workspace:*",
    "@agent-device/provision-kit": "workspace:*",
    "@agent-device/test-kit": "workspace:*",
    "@agent-device/build-config": "workspace:*",
    "@agent-device/platform-android": "workspace:*",
    "@agent-device/host-kit": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/agent-device.mjs"
      },
      "./agent-device": {
        "import": "./dist/agent-device.mjs"
      }
    },
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callstack/agent-device.git",
    "directory": "packages/provider-adc"
  },
  "engines": {
    "node": ">=22.12"
  },
  "agent-device": {
    "apiVersion": 3,
    "provider": "adc"
  },
  "homepage": "https://agent-device.dev/docs/adc"
}
