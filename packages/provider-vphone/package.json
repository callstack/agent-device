{
  "name": "@agent-device/vphone",
  "version": "0.21.40-dev",
  "type": "module",
  "description": "Attach-only vphone iOS provider plugin for agent-device.",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "prepack": "pnpm build"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./agent-device": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@agent-device/capture-kit": "workspace:*",
    "@agent-device/contracts": "workspace:*",
    "@agent-device/kernel": "workspace:*",
    "@agent-device/selectors": "workspace:*",
    "@agent-device/test-kit": "workspace:*",
    "agent-device": "workspace:*",
    "pngjs": "^7.0.0"
  },
  "agentDevicePlugin": {
    "apiVersion": 1,
    "provider": "vphone",
    "entry": "./dist/plugin.mjs",
    "connection": {
      "leaseKind": "direct-device-provider",
      "requiresAppAttachment": false,
      "requiresRemoteDaemon": false,
      "supportsArtifacts": false,
      "supportsDeferredAppSelection": false,
      "supportsDirectPortReverse": false,
      "usesCloudWebDriverLease": false
    },
    "credentialVariables": []
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": "./dist/agent-device.mjs"
      },
      "./agent-device": {
        "import": "./dist/agent-device.mjs"
      }
    },
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/callstack/agent-device.git",
    "directory": "packages/provider-vphone"
  }
}
