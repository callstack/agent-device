    },
    "./ime-helper": {
      "types": "./src/ime-helper.ts",
      "default": "./src/ime-helper.ts"
    },
    "./ime-lifecycle": {
      "types": "./src/ime-lifecycle.ts",
      "default": "./src/ime-lifecycle.ts"
