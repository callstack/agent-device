{
  "name": "@agent-device/platform-android",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Android-family platform runtime metadata and implementations for agent-device.",
  "dependencies": {
    "@agent-device/capture-kit": "workspace:*",
    "@agent-device/contracts": "workspace:*",
