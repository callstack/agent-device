{
  "cases": [
    {
      "name": "native showing hint",
      "attributes": {
        "class": "android.widget.EditText",
        "text": "Your name",
        "hint": "Your name",
        "hint-showing": "true"
      },
      "value": ""
    },
    {
      "name": "typed hint-equal text",
      "attributes": {
        "class": "android.widget.EditText",
        "text": "Your name",
        "hint": "Your name",
        "hint-showing": "false"
      },
      "value": "Your name"
    },
    {
      "name": "unknown hint state preserves equal text",
      "attributes": {
        "class": "android.widget.EditText",
        "text": "Your name",
        "hint": "Your name"
      },
      "value": "Your name"
    },
    {
      "name": "invalid hint state preserves equal text",
      "attributes": {
        "class": "android.widget.EditText",
        "text": "Your name",
        "hint": "Your name",
        "hint-showing": "unknown"
      },
      "value": "Your name"
    },
    {
      "name": "static text has no echoed value",
      "attributes": {
        "class": "android.widget.TextView",
        "text": "Name"
      },
      "value": null
    },
    {
      "name": "static explicit value is not field content",
      "attributes": {
