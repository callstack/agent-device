{
  "description": "Independent trait cases at producer seams. Bridge words and Limrun trait names are producer-specific inputs, not a raw encoding equivalence. Limrun keeps reported types, uses IsEditing for a focus witness, and recognizes TabButton during collapsed-bar recovery. XCTest takes XCUIElement types and is not applicable to trait classification; live conformance remains its authority. Absent expected keys mean absent facts.",
  "cases": [
    {
      "name": "tab trait overrides cell type",
      "applicability": {
        "bridge": "applicable",
        "limrun": "applicable",
        "runner": "not-applicable"
      },
      "bridge": {
        "input": {
          "automationType": 75,
          "traits": "146297323520"
        },
        "expected": {
          "type": "Button"
        }
      },
      "limrun": {
        "input": {
          "type": "RadioButton",
          "traits": ["Button", "TabButton"]
        },
        "expected": {
          "tabCandidate": true
        },
        "seam": "tab"
      }
    },
    {
      "name": "cell without tab trait",
      "applicability": {
        "bridge": "applicable",
        "limrun": "applicable",
        "runner": "not-applicable"
      },
      "bridge": {
        "input": {
          "automationType": 75,
          "traits": "146028888064"
        },
        "expected": {
          "type": "Cell"
        }
      },
      "limrun": {
        "input": {
          "type": "RadioButton",
          "traits": ["Button"]
        },
        "expected": {
          "tabCandidate": false
        },
        "seam": "tab"
      }
    },
