{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "../../.tmp/examples-sdk.tsbuildinfo",
    "paths": {
      "agent-device": ["../../src/sdk/index.ts"],
      "agent-device/io": ["../../src/sdk/io.ts"],
      "agent-device/artifacts": ["../../src/sdk/artifacts.ts"],
      "agent-device/metro": ["../../src/sdk/metro.ts"],
      "agent-device/batch": ["../../src/sdk/batch.ts"],
      "agent-device/remote-config": ["../../src/sdk/remote-config.ts"],
      "agent-device/install-source": ["../../src/sdk/install-source.ts"],
      "agent-device/android-adb": ["../../src/sdk/android-adb.ts"],
      "agent-device/contracts": ["../../src/sdk/contracts.ts"],
      "agent-device/finders": ["../../src/sdk/finders.ts"],
      "agent-device/selectors": ["../../src/sdk/selectors.ts"],
      "agent-device/ai-sdk": ["../../src/ai-sdk/index.ts"]
    }
  },
  // Scoped to this directory only: these examples import `agent-device/...`
  // by package name (the published export map), and `paths` above resolves
  // those specifiers straight to `src/sdk/` so CI typechecks them without a
  // prior build, workspace link, or publish step. Running an example for real
  // still resolves `agent-device` as a self-referencing package (needs
  // `pnpm build`), matching how a real consumer would import it.
  //
  // Composite under `tsc -b`, so every file its program loads through `paths`
  // must be listed here — hence the `../../src/**/*` include with the test and
  // fixture exclusions. The workspace packages those sources reach are project
  // references: their exports-map `.ts` targets resolve to the `dist-types`
  // declarations the graph emits instead of becoming unlisted foreign inputs.
  "include": [".", "../../src/**/*", "../../packages/command-registry/src/global.d.ts"],
  "exclude": ["../../src/**/*.test.ts", "../../src/**/__tests__/**", "../../src/**/*.fixtures.ts"],
  "references": [
    { "path": "../../packages/ad-replay" },
    { "path": "../../packages/ad-script" },
    { "path": "../../packages/capture-kit" },
    { "path": "../../packages/command-registry" },
    { "path": "../../packages/contracts" },
    { "path": "../../packages/device-selection" },
    { "path": "../../packages/host-kit" },
    { "path": "../../packages/kernel" },
    { "path": "../../packages/maestro" },
    { "path": "../../packages/managed-allocation" },
    { "path": "../../packages/platform-android" },
    { "path": "../../packages/platform-apple" },
    { "path": "../../packages/platform-harmonyos" },
    { "path": "../../packages/platform-linux" },
    { "path": "../../packages/platform-vega" },
    { "path": "../../packages/platform-web" },
    { "path": "../../packages/provider-limrun" },
    { "path": "../../packages/provider-testmu" },
    { "path": "../../packages/provider-webdriver" },
    { "path": "../../packages/provision-kit" },
    { "path": "../../packages/proxy" },
    { "path": "../../packages/replay-port" },
    { "path": "../../packages/replay-test" },
    { "path": "../../packages/selectors" },
    { "path": "../../packages/session-journal" },
    { "path": "../../packages/xml" }
  ]
}
