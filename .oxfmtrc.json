{
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".claude/**",
    "dist/**",
    "node_modules/**",
    "**/*.md",
    "scripts/maestro-conformance/corpus/**",
    "fallow-baselines/**",
    // One entry per line, so each pinned runner request changes as one reviewable diff line.
    "contracts/fixtures/runner-requests.json",
    // One captured node per line, so the real keyboard capture stays a compact reviewable table.
    "packages/capture-kit/src/snapshot-chrome.fixtures.ts"
  ]
}
