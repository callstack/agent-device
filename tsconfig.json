{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "incremental": true,
    "tsBuildInfoFile": "./.tmp/tsconfig.tsbuildinfo",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "agent-device/plugins": ["./src/sdk/plugins.ts"],
      "agent-device/plugins/webdriver": ["./src/sdk/plugin-webdriver.ts"]
    }
  },
  "include": [
    "src",
    "test",
    "scripts/help-conformance-command-validator.ts",
    "scripts/coverage-crap/**/*.ts",
    "scripts/coverage-changed/**/*.ts",
    "scripts/vitest-coverage-run-stamp-reporter.ts",
    "scripts/vitest-coverage-run-stamp-reporter.test.ts",
    "packages/command-registry/src/global.d.ts"
  ]
}
